# READ-ONLY connection for the `taleemplus_ml_reader` role (create it with
# scripts/create_ml_readonly_user.sql). Neon example (use the DIRECT endpoint,
# i.e. host WITHOUT "-pooler", and keep sslmode=require):
DATABASE_URL=postgresql://taleemplus_ml_reader:REPLACE_WITH_ML_READER_PASSWORD@<your-neon-host>.aws.neon.tech/neondb?sslmode=require
# Shared secret between this service and the Node.js backend (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ML_INTERNAL_TOKEN=replace-with-a-long-random-secret
ML_ARTIFACT_DIR=./artifacts
ML_MIN_FEE_SAMPLES=100
ML_MIN_PERFORMANCE_SAMPLES=100
ML_RETRAIN_INTERVAL_HOURS=24
# Optional: persist trained models to a PRIVATE Hugging Face repo
# (required on Hugging Face Spaces, whose disk is ephemeral). Without these the
# service runs locally and persistence is a safe no-op.
HF_TOKEN=
HF_REPO_ID=            # e.g. your-name/taleemplus-ml-artifacts  (legacy name: HF_ARTIFACT_REPO)
HF_REPO_TYPE=model     # model (default) | dataset | space
# Transient-failure retry budget for Hub upload/download (optional):
# HF_MAX_RETRIES=3
# HF_BACKOFF_SECONDS=2
