PORT=5000
NODE_ENV=development
# Local dev default. The repo-local cluster started by `npm run db:start`
# listens on 5433; CI/production should override this value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/taleemplus_db?schema=public"
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-64-random-hex-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-a-different-64-random-hex-characters"
REFRESH_TOKEN_EXPIRES_IN="7d"
CORS_ORIGINS=""

# Optional account lockout tuning (defaults shown)
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# --- File storage (Phase 7) ---------------------------------------------
# Production: connect a PRIVATE Vercel Blob store; Vercel injects
# BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN. Locally files go to
# LOCAL_UPLOAD_DIR (default taleemplus_backend/uploads, git-ignored).
# STORAGE_DRIVER=local|blob   (auto-detected when unset)
# BLOB_READ_WRITE_TOKEN=
# LOCAL_UPLOAD_DIR=

# --- ML service (Phase 10) ----------------------------------------------
# ML_SERVICE_URL=http://127.0.0.1:8100
# ML_INTERNAL_TOKEN=same-64-hex-secret-as-the-ml-service
# ML_TIMEOUT_MS=25000

# --- Geocoding (Phase 6, OpenStreetMap Nominatim, no key) ----------------
# GEOCODER_USER_AGENT=TaleemPlus/1.0 (contact: admin@your-academy.example)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
