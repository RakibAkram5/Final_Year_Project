generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AccountStatus {
  ACTIVE
  PENDING
  REJECTED
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LegacyMappingStatus {
  PENDING
  MAPPED
  SKIPPED
  FAILED
}

model Academy {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  address               String?
  phone                 String?
  logo                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  paymentQrData         Bytes?
  paymentQrMimeType     String?
  paymentProvider       String?
  paymentAccountTitle   String?
  paymentAccountDetails String?
  paymentQrEnabled      Boolean  @default(false)
  legacyFirebaseUid     String?  @unique
  academicStructure     Json?
  // Phase 6: academy location (OpenStreetMap / Nominatim, WGS84)
  latitude              Decimal? @db.Decimal(9, 6)
  longitude             Decimal? @db.Decimal(9, 6)
  locationLabel         String?
  // Phase 8: structured bank details shown to parents and students
  bankName              String?
  bankAccountNumber     String?
  bankIban              String?
  paymentInstructions   String?
  // White-label branding: each academy owns its identity. The logo is stored
  // as validated image bytes (PNG/JPEG/WebP, size-capped) so it renders the
  // same on Android, Web and inside generated PDFs without a public URL.
  email                 String?
  logoData              Bytes?
  logoMimeType          String?
  logoUpdatedAt         DateTime?

  users             User[]
  classes           Class[]
  classSections     ClassSection[]
  classReports      ClassReport[]
  attendanceRecords AttendanceRecord[]
  feeChallans       FeeChallan[]
  paymentProofs     FeePaymentProof[]
  announcements     Announcement[]
  quizzes           Quiz[]
  testMarks         TestMark[]
  quizSubmissions   QuizSubmission[]
  sharedResources   SharedResource[]
  studentQueries    StudentQuery[]
  notifications     Notification[]
  timetableSlots    TimetableSlot[]
  ocrDocuments      OcrDocument[]
  storedFiles       StoredFile[]
  assignments       Assignment[]

  @@map("academies")
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String
  fullName            String
  studentCode         String?       @unique
  rollNumber          String?
  phoneNumber         String?
  role                Role
  accountStatus       AccountStatus @default(PENDING)
  academyId           String
  assignedSections    String[]      @default([])
  legacyFirebaseUid   String?       @unique
  subject             String?
  extraInfo           String?
  joiningDate         DateTime?
  securityQuestion    String?
  securityAnswerHash  String?
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  deactivatedAt       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  academy                Academy                  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  parentLinks            ParentStudent[]          @relation("ParentRelation")
  studentLinks           ParentStudent[]          @relation("StudentRelation")
  enrollments            StudentEnrollment[]
  sectionEnrollments     ClassSectionEnrollment[]
  markedAttendance       AttendanceRecord[]       @relation("MarkedBy")
  studentAttendance      AttendanceRecord[]       @relation("StudentAttendance")
  taughtClasses          Class[]                  @relation("PrimaryTeacher")
  feeChallans            FeeChallan[]             @relation("StudentChallan")
  submittedPaymentProofs FeePaymentProof[]
  reviewedPaymentProofs  FeePaymentProof[]        @relation("ReviewedPaymentProofs")
  createdNotices         Announcement[]           @relation("CreatedBy")
  createdQuizzes         Quiz[]                   @relation("QuizCreatedBy")
  testMarks              TestMark[]               @relation("StudentMarks")
  quizSubmissions        QuizSubmission[]         @relation("StudentQuizSubmissions")
  resources              SharedResource[]         @relation("TeacherResources")
  askedQueries           StudentQuery[]           @relation("StudentQueries")
  answeredQueries        StudentQuery[]           @relation("TeacherQueries")
  ocrDocs                OcrDocument[]            @relation("UserOcrDocs")
  notifications          Notification[]           @relation("RecipientNotifications")
  timetableSlots         TimetableSlot[]          @relation("TeacherTimetable")
  refreshTokens          RefreshToken[]
  uploadedFiles          StoredFile[]             @relation("FileUploader")
  createdAssignments     Assignment[]             @relation("AssignmentCreator")
  assignmentSubmissions  AssignmentSubmission[]   @relation("AssignmentStudent")
  parentLinkRequests     ParentLinkRequest[]      @relation("LinkRequestParent")
  studentLinkRequests    ParentLinkRequest[]      @relation("LinkRequestStudent")

  @@index([academyId, role])
  @@index([academyId, accountStatus, role])
  @@map("users")
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_student_relationships")
}

// A parent's request to be linked to an existing student. A parent submits the
// child's identifying details; an academy admin verifies and approves, which
// creates the ParentStudent link. This keeps self-service linking from exposing
// any student's data to an unrelated parent (see parentPortal security fix).
enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ParentLinkRequest {
  id          String            @id @default(uuid())
  academyId   String
  parentId    String
  studentId   String? // the matched student, resolved by the backend/admin
  childName   String
  childEmail  String?
  rollNumber  String?
  status      LinkRequestStatus @default(PENDING)
  note        String? // admin's reason on reject, or a system note
  decidedById String? // admin user id who approved/rejected
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  parent  User  @relation("LinkRequestParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User? @relation("LinkRequestStudent", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([academyId, status])
  @@index([parentId, status])
  @@map("parent_link_requests")
}

model Class {
  id               String   @id @default(uuid())
  academyId        String
  className        String
  section          String
  subject          String
  program          String?
  classSectionId   String?
  primaryTeacherId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academy           Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  classSection      ClassSection?       @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  primaryTeacher    User?               @relation("PrimaryTeacher", fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  quizzes           Quiz[]
  testMarks         TestMark[]
  sharedResources   SharedResource[]
  studentQueries    StudentQuery[]
  timetableSlots    TimetableSlot[]
  assignments       Assignment[]

  @@unique([academyId, className, section, subject])
  @@index([academyId, classSectionId])
  @@map("classes")
}

model ClassSection {
  id        String   @id @default(uuid())
  academyId String
  className String
  program   String   @default("")
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy     Academy                  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  enrollments ClassSectionEnrollment[]
  classes     Class[]

  @@unique([academyId, className, program, section])
  @@index([academyId, className])
  @@map("class_sections")
}

model ClassSectionEnrollment {
  id         String   @id @default(uuid())
  sectionId  String
  studentId  String
  rollNumber String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, studentId])
  @@unique([sectionId, rollNumber])
  @@index([studentId])
  @@map("class_section_enrollments")
}

model ClassReport {
  id               String   @id @default(uuid())
  academyId        String
  classLabel       String
  generatedAt      DateTime @default(now())
  totalStudents    Int      @default(0)
  present          Int      @default(0)
  absent           Int      @default(0)
  feePaid          Int      @default(0)
  feePending       Int      @default(0)
  feePaidAmount    Decimal  @default(0) @db.Decimal(12, 2)
  feePendingAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@index([academyId, generatedAt])
  @@map("class_reports")
}

model StudentEnrollment {
  id         String   @id @default(uuid())
  classId    String
  studentId  String
  rollNumber String?
  createdAt  DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("student_enrollments")
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  academyId  String
  classId    String
  studentId  String
  logDate    String
  status     AttendanceStatus
  markedById String
  recordedAt DateTime         @default(now())

  academy  Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  User    @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User    @relation("MarkedBy", fields: [markedById], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, logDate])
  @@index([academyId, logDate])
  @@index([academyId, classId, logDate])
  @@index([studentId, logDate])
  @@map("attendance_records")
}

model FeeChallan {
  id            String    @id @default(uuid())
  academyId     String
  challanNumber String    @unique
  studentId     String
  studentName   String
  fatherName    String?
  classLabel    String
  rollNumber    String?
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  monthlyFee    Decimal   @db.Decimal(10, 2)
  admissionFee  Decimal   @default(0) @db.Decimal(10, 2)
  examFee       Decimal   @default(0) @db.Decimal(10, 2)
  transportFee  Decimal   @default(0) @db.Decimal(10, 2)
  fine          Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  status        FeeStatus @default(PENDING)
  paidAt        DateTime?
  billingPeriod String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  academy       Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student       User              @relation("StudentChallan", fields: [studentId], references: [id], onDelete: Cascade)
  paymentProofs FeePaymentProof[]

  @@unique([academyId, studentId, billingPeriod])
  @@index([academyId, status, dueDate])
  @@map("fee_challans")
}

model FeePaymentProof {
  id            String             @id @default(uuid())
  academyId     String
  challanId     String
  submittedById String
  reviewedById  String?
  imageData     Bytes
  mimeType      String
  status        PaymentProofStatus @default(PENDING)
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  academy       Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  challan       FeeChallan         @relation(fields: [challanId], references: [id], onDelete: Cascade)
  submittedBy   User               @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy    User?              @relation("ReviewedPaymentProofs", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([academyId, status, submittedAt])
  @@map("fee_payment_proofs")
}

model Announcement {
  id          String   @id @default(uuid())
  academyId   String
  title       String
  message     String
  targetRoles String[] @default(["all"])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([academyId, createdAt])
  @@map("announcements")
}

model Quiz {
  id           String    @id @default(uuid())
  academyId    String
  classId      String
  classLabel   String
  title        String
  subject      String
  month        String?
  session      String?
  chapter      String?
  difficulty   String?
  totalMarks   Int
  testDate     DateTime?
  instructions String?
  // Examination-paper layout + teacher answer key (sections, attempt-any
  // counts, exam metadata and short/long model answers). Nullable so legacy
  // quizzes and non-exam quizzes are unaffected.
  paperMeta    Json?
  // Online attempts: PAPER quizzes are printed and sat in class (default);
  // ONLINE quizzes can be attempted in the student portal until
  // availableUntil, with an optional per-attempt time limit.
  attemptMode     String    @default("PAPER")
  availableFrom   DateTime?
  availableUntil  DateTime?
  durationMinutes Int?
  createdById  String
  createdAt    DateTime  @default(now())

  academy     Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  testMarks   TestMark[]
  submissions QuizSubmission[]

  @@index([academyId, classId, createdAt])
  @@map("quizzes")
}

model QuizQuestion {
  id              String   @id @default(uuid())
  quizId          String
  text            String
  type            String   @default("short")
  options         String[] @default([])
  correctIndex    Int?
  marks           Int      @default(5)
  gradingKeywords String[] @default([])

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@map("quiz_questions")
}

model TestMark {
  id              String   @id @default(uuid())
  academyId       String
  quizId          String
  studentId       String
  studentName     String
  classId         String
  subject         String
  month           String?
  marksObtained   Float
  totalMarks      Float
  percentage      Float
  gradeLetter     String
  teacherFeedback String?
  updatedAt       DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User    @relation("StudentMarks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([academyId, classId, month])
  @@map("test_marks")
}

// One student's attempt at an ONLINE quiz. Exactly one per (quiz, student):
// the unique constraint is what makes submission retries safe (a second
// submit finds the SUBMITTED row and returns it instead of grading twice).
model QuizSubmission {
  id            String    @id @default(uuid())
  academyId     String
  quizId        String
  studentId     String
  status        String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  gradedAt      DateTime?
  // Marks for auto-graded (MCQ) questions, computed server-side on submit.
  autoScore     Float?
  autoMaxScore  Float?
  // Final marks once every question has a score (auto + teacher review).
  finalScore    Float?
  needsReview   Boolean   @default(false)
  teacherNote   String?
  updatedAt     DateTime  @updatedAt

  academy Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User         @relation("StudentQuizSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, studentId])
  @@index([academyId, quizId, status])
  @@index([studentId, submittedAt])
  @@map("quiz_submissions")
}

model QuizAnswer {
  id            String   @id @default(uuid())
  submissionId  String
  questionId    String
  selectedIndex Int?
  answerText    String?
  // Set on submit for MCQs; set by the teacher for short/long answers.
  isCorrect     Boolean?
  marksAwarded  Float?
  updatedAt     DateTime @updatedAt

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("quiz_answers")
}

model SharedResource {
  id          String   @id @default(uuid())
  academyId   String
  classId     String
  teacherId   String
  title       String
  description String?
  fileUrl     String?
  contentText String?
  fileName    String?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User    @relation("TeacherResources", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([academyId, classId, createdAt])
  @@map("shared_resources")
}

model StudentQuery {
  id         String    @id @default(uuid())
  academyId  String
  classId    String
  studentId  String
  teacherId  String?
  question   String
  answer     String?
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User    @relation("StudentQueries", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User?   @relation("TeacherQueries", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([academyId, isResolved, createdAt])
  @@index([teacherId, isResolved, createdAt])
  @@index([studentId, createdAt])
  @@map("student_queries")
}

model OcrDocument {
  id            String   @id @default(uuid())
  academyId     String?
  createdById   String
  createdByName String?
  title         String
  extractedText String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  academy   Academy? @relation(fields: [academyId], references: [id], onDelete: SetNull)
  createdBy User     @relation("UserOcrDocs", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([academyId, createdById, createdAt])
  @@index([createdById, createdAt])
  @@map("ocr_documents")
}

model Notification {
  id          String   @id @default(uuid())
  academyId   String
  recipientId String
  title       String
  message     String
  type        String   @default("general")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  recipient User    @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([academyId, recipientId, createdAt])
  @@index([academyId, recipientId, isRead])
  @@map("notifications")
}

model TimetableSlot {
  id            String    @id @default(uuid())
  academyId     String
  classId       String?
  section       String
  dayOfWeek     String
  startTime     String
  endTime       String
  subject       String
  teacherId     String?
  dayOfWeekInt  Int?
  startMinutes  Int?
  endMinutes    Int?
  room          String?
  semester      String?
  isBreak       Boolean   @default(false)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User?   @relation("TeacherTimetable", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([academyId, classId, dayOfWeekInt])
  @@index([academyId, teacherId, dayOfWeekInt])
  @@map("timetable_slots")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
  @@map("refresh_tokens")
}

model LegacyIdMap {
  collection  String              @map("collection")
  legacyId    String              @map("legacy_id")
  targetTable String              @map("target_table")
  targetId    String              @map("target_id")
  status      LegacyMappingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@id([collection, legacyId])
  @@index([targetTable, targetId])
  @@map("legacy_id_map")
}

/// Metadata for every uploaded file. The bytes live in private storage
/// (Vercel Blob in production, a local folder in development); clients only
/// ever download through the authenticated /files/:id/content route.
model StoredFile {
  id            String   @id @default(uuid())
  academyId     String
  /// What the file belongs to: COURSE_MATERIAL, STUDENT_DOCUMENT,
  /// TEACHER_DOCUMENT, ASSIGNMENT_INSTRUCTION, ASSIGNMENT_SUBMISSION,
  /// EXAM_DOCUMENT
  category      String
  /// Id of the related record (resource, user, assignment, submission, quiz)
  ownerId       String
  originalName  String
  storageKey    String   @unique
  storageDriver String
  mimeType      String
  sizeBytes     Int
  sha256        String
  description   String?
  uploadedById  String
  createdAt     DateTime @default(now())

  academy    Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([academyId, category, ownerId])
  @@map("stored_files")
}

model Assignment {
  id                String   @id @default(uuid())
  academyId         String
  classId           String
  title             String
  instructions      String?
  dueAt             DateTime
  maxMarks          Int?
  allowResubmission Boolean  @default(true)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  academy     Academy                @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([academyId, classId, dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  studentId    String
  note         String?
  submittedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  marks        Float?
  feedback     String?
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}
