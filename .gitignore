# Secrets
.env
.env.*
**/.env
**/.env.*

# Node
node_modules/
**/node_modules/

# Generated Prisma client
taleemplus_backend/generated/

# Migration exports (may contain PII; never commit)
migration_exports/
**/migration_exports/
*.jsonl


# Flutter
.dart_tool/
build/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
.idea/
*.iml
.pub-cache/
.pub/

# Android keys
*.jks
*.keystore
key.properties
local.properties
.vercel
.env*

# Vercel prebuilt web output
vercel_web/

# Local PostgreSQL data directory and DB backups (never commit)
taleemplus_backend/.pgdata/
taleemplus_backend/backups/

# Kotlin compiler daemon session files
android/.kotlin/

# Keep example env templates tracked
!.env.example
!**/.env.example

# Netlify CLI local state and build cache
.netlify/
/.cache/

# Local file storage driver (development uploads)
taleemplus_backend/uploads/

# Hugging Face Space staging folder
ml_service/hf_space/build/
ml_service/artifacts/

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/
